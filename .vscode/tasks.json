{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "install:client",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "install:server",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "problemMatcher": []
    },
    {
      "label": "dev:client",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".*"
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "dev:server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".*"
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "OmniAI server running"
        }
      }
    },
    {
      "label": "dev:all",
      "dependsOn": [
        "dev:client",
        "dev:server"
      ],
      "dependsOrder": "parallel"
    },
    {
      "label": "lint:all",
      "type": "shell",
      "command": "npm run lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "build:client",
      "type": "shell",
      "command": "npm run build"
    }
  ]
}
