{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend: Chrome (Vite)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src",
      "preLaunchTask": "dev:all"
    },
    {
      "name": "Backend: Node (server)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "OmniAI Full Stack",
      "configurations": [
        "Backend: Node (server)",
        "Frontend: Chrome (Vite)"
      ]
    }
  ]
}
